# Browser-side configuration (simplify/direct-agent-studio).
# The app talks to Algolia and Agent Studio directly from the browser, so these
# three ship to the client in the bundle. That is the normal InstantSearch
# posture: the key is search-only and public by design. Restrict it in the
# Algolia dashboard rather than hiding it.
#
# This reverses the older rule in docs/deployment.md ("never put an Algolia key
# or agent ID in a VITE_* value"), which existed because every call used to go
# through the app's own server. That server is being removed.
VITE_ALGOLIA_APP_ID=your_algolia_application_id
VITE_ALGOLIA_SEARCH_API_KEY=your_search_only_algolia_key
VITE_JTV_AGENT_ID=your_published_agent_id

# Server-side configuration. Still read by the legacy Node API while it exists;
# delete these once app/server/ is gone. Keep real values in the gitignored
# app/.env locally, or the protected Vercel project's environment.
ALGOLIA_APP_ID=your_algolia_application_id
ALGOLIA_SEARCH_API_KEY=your_search_only_algolia_key

# Exact hosted domain allowlist, no wildcard.
APP_ALLOWED_HOSTS=jewellerytv.vercel.app

# Local development uses the development ID. Production uses the production ID.
# Two different agents with identical definitions. Development is what `npm run dev`
# talks to; production is what the hosted site talks to. The app refuses to start if
# they are the same. See docs/BASELINE.md.
JTV_CONCIERGE_DEVELOPMENT_AGENT_ID=your_published_development_agent_id
JTV_CONCIERGE_PRODUCTION_AGENT_ID=your_published_hosted_agent_id
