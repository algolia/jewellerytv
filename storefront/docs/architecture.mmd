flowchart TB
  subgraph B["Shopper's browser"]
    direction LR
    Shopper["Shopper"] -->|"types a request"| Page["JTV page: conversation left, product tiles right"]
    Page -->|"the message"| Chat["Chat client (InstantSearch, in the page)"]
    Chat -->|"streamed reply carries the checked pieces"| Tiles["Product tiles: one column per group, only checked pieces"]
    Page -->|"saved pieces, per tab"| State[("Session state, per tab")]
    Chat -->|"routes the agent's tool calls here"| Check["Product checks in the browser: in stock, price fits, groups fill"]
  end

  subgraph S["JTV website server (Node)"]
    direction LR
    ChatAPI["Chat API (/api/chat): forwards to the agent"] --> Guard{"Tool check: the agent may only offer tools this build can run"}
    ReadOnly["Read-only APIs: product lookups, search, refresh"]
  end

  subgraph A["Algolia Agent Studio"]
    direction LR
    Out["Output guardrail: reviews every reply against five rules; can withhold it"] -->|"approved reply"| Agent["Concierge agent: one definition; test and live identical"]
    Agent -->|"searches"| Search["Catalogue search, the agent's own tool"]
    Search --> Catalogue[("JTV catalogue: products, blog, help articles, read-only")]
  end

  Chat -->|"the message"| ChatAPI
  Guard -->|"tools match"| Agent
  Guard -.->|"mismatch: the page shows a clear error, not a failure"| Chat
  Check -->|"looks up each piece, read-only"| ReadOnly
  ReadOnly -->|"reads the same catalogue"| Catalogue
  Agent -->|"the reply, streamed"| Chat
  Out -.->|"withheld: a fixed notice; the checked tiles stay"| Page

  subgraph Release["How a change reaches production"]
    direction LR
    Local["Change and test locally: npm run dev + dev agent"] --> Main["Merge to main: pull request, CI green"]
    Main --> Promote["Promote: scripts/baseline, agent then app"]
    Promote --> Prod["Production: Vercel app + production agent"]
    Prod --> Verify["verify-baseline.mjs"]
  end
